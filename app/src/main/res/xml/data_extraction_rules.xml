<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hydrobox_secure_session.xml" />
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
        <exclude domain="database" path="hydro_local.db" />
        <exclude domain="database" path="hydro_local.db-shm" />
        <exclude domain="database" path="hydro_local.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hydrobox_secure_session.xml" />
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
        <exclude domain="database" path="hydro_local.db" />
        <exclude domain="database" path="hydro_local.db-shm" />
        <exclude domain="database" path="hydro_local.db-wal" />
    </device-transfer>
</data-extraction-rules>
